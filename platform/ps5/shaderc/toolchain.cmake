# Compile static compiler libraries with the same public PS5 target ABI as SC2.
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "${SC2_SHADERC_LLVM}/clang.exe")
set(CMAKE_CXX_COMPILER "${SC2_SHADERC_LLVM}/clang++.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR "${SC2_SHADERC_LLVM}/llvm-ar.exe")
set(CMAKE_RANLIB "${SC2_SHADERC_LLVM}/llvm-ranlib.exe")
set(CMAKE_C_FLAGS_INIT "-isysroot ${SC2_SHADERC_SDK} -isystem ${SC2_SHADERC_SDK}/target/include -fno-stack-protector -femulated-tls -fPIC")
set(CMAKE_CXX_FLAGS_INIT "-isysroot ${SC2_SHADERC_SDK} -isystem ${SC2_SHADERC_SDK}/target/include/c++/v1 -isystem ${SC2_SHADERC_SDK}/target/include -fno-stack-protector -femulated-tls -fPIC -fexceptions -frtti")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_FIND_ROOT_PATH "${SC2_SHADERC_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SC2_SHADERC_LLVM SC2_SHADERC_SDK)
